Schedule:Day:Interval,
  Activity Default Schedule 1,              !- Name
  ActivityLevel,                          !- Schedule Type Limits Name
  No,                                     !- Interpolate to Timestep
  24:00,                                  !- Time 1
  120;                                    !- Value Until Time 1
! #################################################################################
! activity design day
Schedule:Day:Interval,
  Office Activity Summer Design Day 1,      !- Name
  ActivityLevel,                          !- Schedule Type Limits Name
  No,                                     !- Interpolate to Timestep
  24:00,                                  !- Time 1
  120;                                    !- Value Until Time 1
Schedule:Day:Interval,
  Office Activity Winter Design Day 1,      !- Name
  ActivityLevel,                          !- Schedule Type Limits Name
  No,                                     !- Interpolate to Timestep
  24:00,                                  !- Time 1
  120;                                    !- Value Until Time 1
! #################################################################################
! acctivity daily
Schedule:Week:Daily,
  People Activity 1 Week Rule - Jan1-Dec31, !- Name
