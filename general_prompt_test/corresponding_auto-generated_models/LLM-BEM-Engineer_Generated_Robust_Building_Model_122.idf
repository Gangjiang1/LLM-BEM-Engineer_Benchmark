Schedule:Day:Interval,
  Deck_Temperature_Default 1,               !- Name
  Temperature 37,                         !- Schedule Type Limits Name
  No,                                     !- Interpolate to Timestep
  24:00,                                  !- Time 1
  13.0;                                   !- Value Until Time 1

Schedule:Day:Interval,
  Deck_Temperature_Summer_Design_Day 1,     !- Name
  Temperature 37,                         !- Schedule Type Limits Name
  No,                                     !- Interpolate to Timestep
