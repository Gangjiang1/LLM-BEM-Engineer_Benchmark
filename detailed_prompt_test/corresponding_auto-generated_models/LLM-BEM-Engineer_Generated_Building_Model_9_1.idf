NodeList,
  Thermal Zone 4 Exhaust Node List,        !- Name
  Node Air Thermal Zone 4 Out;            !- Node Name

Fan:OnOff,
  Fan Coil with Cycling Fan - Fan 4,      !- Name
  Always On Discrete hvac_library,        !- Availability Schedule Name
  0.75,                                    !- Fan Total Efficiency
  1395,                                    !- Pressure Rise Pa
  99.64,                               !- Maximum Flow Rate m3/s
  0.8,                                    !- Motor Efficiency
  1,                                      !- Motor In Airstream Fraction
