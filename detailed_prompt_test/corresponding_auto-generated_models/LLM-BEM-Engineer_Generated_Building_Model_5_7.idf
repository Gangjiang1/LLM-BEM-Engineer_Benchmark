  ClgSetp Default Schedule 18,               !- Monday Schedule:Day Name
  ClgSetp Default Schedule 18,               !- Tuesday Schedule:Day Name
  ClgSetp Default Schedule 18,               !- Wednesday Schedule:Day Name
  ClgSetp Default Schedule 18,               !- Thursday Schedule:Day Name
  ClgSetp Default Schedule 18,               !- Friday Schedule:Day Name
  ClgSetp Default Schedule 18,               !- Saturday Schedule:Day Name
  ClgSetp Default Schedule 18,               !- Holiday Schedule:Day Name
  ClgSetp Summer Design Day 18,              !- SummerDesignDay Schedule:Day Name
  ClgSetp Winter Design Day 18,              !- WinterDesignDay Schedule:Day Name
  ClgSetp Default Schedule 18,               !- CustomDay1 Schedule:Day Name
  ClgSetp Default Schedule 18;               !- CustomDay2 Schedule:Day Name

! thermos cooling yearly schedule
Schedule:Year,
  ClgSetp 18,                                !- Name
  Temperature 37,                                        !- Schedule Type Limits Name
  ClgSetp 18 Week Rule - Jan1-Dec31,         !- Schedule:Week Name 1
  1,                                                     !- Start Month 1
  1,                                                     !- Start Day 1
  12,                                                    !- End Month 1
  31;                                                    !- End Day 1

! thermos cooling design day schedule
Schedule:Day:Interval,
  ClgSetp Summer Design Day 18,              !- Name
  Temperature 37,                                        !- Schedule Type Limits Name
  No,                                                    !- Interpolate to Timestep
  06:00,                                                 !- Time 1 hh:mm
  26.7,                                                  !- Value Until Time 1
  22:00,                                                 !- Time 2 hh:mm
  24,                                                    !- Value Until Time 2
  24:00,                                                 !- Time 3 hh:mm
  26.7;                                                  !- Value Until Time 3
Schedule:Day:Interval,
  ClgSetp Winter Design Day 18,              !- Name
  Temperature 37,                                        !- Schedule Type Limits Name
  No,                                                    !- Interpolate to Timestep
  24:00,                                                 !- Time 1 hh:mm
  26.7;


